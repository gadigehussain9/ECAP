          "appSettings": "[flatten(createArray(createArray(createObject('name', 'APPLICATIONINSIGHTS_CONNECTION_STRING', 'value', parameters('applicationInsightsConnectionString')), createObject('name', 'AzureOpenAI__Endpoint', 'value', ''), createObject('name', 'AzureOpenAI__Authentication', 'value', 'ManagedIdentity'), createObject('name', 'AzureAISearch__Endpoint', 'value', ''), createObject('name', 'AzureAISearch__Authentication', 'value', 'ManagedIdentity'), createObject('name', 'AzureSql__Connection', 'value', ''), createObject('name', 'AzureSql__Authentication', 'value', 'Active Directory Managed Identity'), createObject('name', 'Storage__Account', 'value', ''), createObject('name', 'Storage__Authentication', 'value', 'ManagedIdentity'), createObject('name', 'AppConfiguration__Endpoint', 'value', ''), createObject('name', 'KeyVault__Uri', 'value', ''), createObject('name', 'KeyVault__ReferencePrefix', 'value', '')), parameters('configuration').additionalAppSettings))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('configuration').planName)]"
